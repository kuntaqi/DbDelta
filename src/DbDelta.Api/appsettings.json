{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Safety": {
    "ReadOnlyServers": [ "DBSERVER-PROD" ],
    "Environments": {
      "Dev": [ "(localdb)*", "*-DEV" ],
      "Uat": [ "*-UAT" ],
      "Prod": [ "*-PROD" ]
    },
    "MaxReviewableScriptBytes": 104857600,
    "MaxDeleteShare": 0.05,
    "MaxClosureRows": 5000,
    "MaxInlineTableBytes": 8388608
  }
}
